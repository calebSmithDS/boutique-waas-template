---
// 1. Tell Astro to render this page on the server on-demand
export const prerender = false;

import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';

// 1. Grab BOTH the slug from the URL and the tenant from the middleware
const { slug } = Astro.params;
const tenantId = Astro.locals.tenantId;



// 2. Query Sanity for a service that matches BOTH the slug and the tenantId
const graphqlQuery = `
  query GetSingleService($tenantId: String!, $slug: String!) {
    allService(where: { 
      tenantId: { eq: $tenantId }, 
      slug: { current: { eq: $slug } } 
    }) {
      title
      description
      seoTitle
      seoDescription
    }
  }
`;

const response = await fetch('https://mc1571jp.api.sanity.io/v2025-09-19/graphql/production/default', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ 
    query: graphqlQuery,
    variables: { tenantId, slug } 
  }),
});

const json = await response.json();
const service = json?.data?.allService?.[0];

// 3. If someone types a bad URL, throw a 404
if (!service) {
  return Astro.redirect('/404');
}
---

<Layout 
  title={service?.seoTitle || `${service.title} | Our Services`} 
  description={service?.seoDescription || `Professional ${service.title} services.`}
>
  <body class="bg-zinc-50 text-zinc-900 font-sans antialiased selection:bg-zinc-200">

    <!-- 2. SERVICE HERO -->
    <section class="bg-zinc-900 py-16 md:py-24 px-6 border-b-4 border-[var(--theme-primary)]">
      <div class="max-w-7xl mx-auto">
        <div class="inline-block bg-zinc-800 text-[var(--theme-primary)] text-xs font-bold px-3 py-1 mb-4 rounded-full uppercase tracking-widest">
          Professional Service
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white uppercase tracking-tight mb-6 max-w-3xl leading-tight">
          {service.title}
        </h1>
      </div>
    </section>

    <!-- 3. MAIN CONTENT & SIDEBAR -->
    <section class="py-12 md:py-20 px-6">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: SEO Text Content (Spans 8 columns) -->
        <main class="lg:col-span-8 bg-white p-8 md:p-12 rounded-2xl shadow-sm border border-zinc-200">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">About Our {service.title} Services</h2>
          
          <!-- whitespace-pre-wrap ensures Sanity paragraphs render with proper line breaks -->
          <div class="text-lg text-zinc-600 leading-relaxed whitespace-pre-wrap">
            {service.description}
          </div>
          
          <div class="mt-10 p-6 bg-zinc-50 border border-zinc-100 rounded-xl">
            <h3 class="font-bold text-zinc-900 mb-2">Why trust us with this job?</h3>
            <ul class="list-disc list-inside text-zinc-600 space-y-2">
              <li>Fully licensed and insured professionals</li>
              <li>Upfront pricing with zero hidden fees</li>
              <li>Clean, tidy, and respectful of your property</li>
            </ul>
          </div>
        </main>

        <!-- Right: Sticky Conversion Sidebar (Spans 4 columns) -->
        <aside class="lg:col-span-4">
          <div class="sticky top-28 bg-white p-8 rounded-2xl shadow-xl border border-zinc-200">
            <h3 class="text-xl font-black text-zinc-900 uppercase tracking-tight mb-4">
              Need this fixed?
            </h3>
            <p class="text-zinc-500 mb-6 text-sm">
              Our local technicians are ready to deploy. Call our emergency line or request a callback.
            </p>
            
            <a href="tel:5558675309" class="w-full block text-center bg-zinc-900 text-white font-bold text-lg px-6 py-4 rounded-lg hover:bg-zinc-800 transition-colors mb-4">
              (555) 867-5309
            </a>
            
            <a href="/#quote" class="w-full block text-center bg-[var(--theme-primary)] text-white font-bold text-lg px-6 py-4 rounded-lg hover:opacity-90 transition-colors shadow-md">
              Request a Quote
            </a>
          </div>
        </aside>

      </div>
    </section>

  </body>
</Layout>