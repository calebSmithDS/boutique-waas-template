---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';

// 1. Combine both requests into a single GraphQL query
const graphqlQuery = `
  query {
    allSiteSettings {
      heroHeadline
      heroSubheadline
      heroImage {
        asset {
          url
        }
      }
      seoTitle,
      seoDescription
    }
    allService {
      title
      description
      slug {
        current
      }
    }
    allTestimonial {
      authorName
      location
      text
    }
  }
`;

// 2. Make ONE fetch request to Sanity
const response = await fetch('https://mc1571jp.api.sanity.io/v2025-09-19/graphql/production/default', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
  },
  body: JSON.stringify({ query: graphqlQuery }),
});

const json = await response.json();

// 3. Extract both pieces of data from the single response
const siteData = json?.data?.allSiteSettings?.[0];
const heroImageUrl = siteData?.heroImage?.asset?.url || "https://images.unsplash.com/photo-1621905251189-08b45d6a269e?q=80&w=2069&auto=format&fit=crop";
const services = json?.data?.allService || [];
const testimonials = json?.data?.allTestimonial || [];

console.log("Site Data:", siteData);
console.log("Services:", services);
---


<Layout 
  title={siteData?.seoTitle || "Smith Plumbing | Emergency Plumber Adelaide"} 
  description={siteData?.seoDescription || "Fast, reliable, 24/7 plumbing services in the Adelaide Hills."}
>

  <body>
    <!-- 2. HERO SECTION -->
    <section class="max-w-7xl mx-auto px-6 py-16 md:py-24">
      <!-- The Grid (Mobile: 1 column, Desktop: 2 columns) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Text Content -->
        <div class="max-w-2xl">
          
          <!-- Trust Badge -->
          <div class="inline-block bg-zinc-100 text-[#213354] font-bold text-xs tracking-widest uppercase px-4 py-2 rounded-full mb-8">
            Licensed & Insured
          </div>
          
          <!-- Headline (Uppercase, heavy weight, tight line-height) -->
         
  <div>
    <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-zinc-900 uppercase tracking-tight leading-[1.1] mb-6">
      {siteData?.heroHeadline || "PROFESSIONAL SERVICE YOU CAN TRUST."}
    </h1>
    <p class="text-lg md:text-xl text-zinc-500 leading-relaxed mb-8 max-w-lg">
      {siteData?.heroSubheadline || "A fast, mobile-first small business website template. Fully customizable for any trade or service business."}
    </p>
    </div>
          
          <!-- Call to Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <a href="#quote" class="bg-[var(--theme-primary)] text-white text-center font-bold px-8 py-4 rounded-lg hover:opacity-90 transition-colors shadow-sm">
              Get a Free Quote
            </a>
            <a href="#services" class="bg-white text-zinc-900 text-center font-bold px-8 py-4 rounded-lg border-2 border-[#0f172a] hover:bg-zinc-50 transition-colors">
              Our Services
            </a>
          </div>
          
          <!-- Secondary Contact -->
          <p class="text-sm font-bold text-zinc-600">
            Call <a href="tel:5558675309" class="text-zinc-900 hover:text-[var(--theme-primary)] transition-colors">(555) 867-5309</a>
          </p>
        </div>

<!-- Right Column: Dynamic Hero Image -->
    <div class="relative">
      <img 
        src={heroImageUrl} 
        alt="Professional at work" 
        class="rounded-3xl shadow-2xl object-cover w-full h-[400px] lg:h-[600px]" 
      />
      
      <!-- Optional: A subtle gradient overlay to make it look premium -->
      <div class="absolute inset-0 rounded-3xl ring-1 ring-inset ring-black/10 pointer-events-none"></div>
    </div>

      </div>
    </section>
<!-- 3. DYNAMIC SERVICES GRID -->
    {services.length > 0 && (
      <section id="services" class="bg-zinc-50 py-20 md:py-32 px-6 border-t border-zinc-100">
        <div class="max-w-7xl mx-auto">
          
          <!-- Section Title (Provides context even if there is only 1 service) -->
          <div class="mb-12">
            <h2 class="text-3xl md:text-4xl font-black text-zinc-900 uppercase tracking-tight">
              Our Services
            </h2>
            <div class="w-16 h-1 bg-[var(--theme-primary)] mt-4"></div>
          </div>

          <!-- The Grid (Automatically handles 1, 2, 3, or more cards) -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            
            {services.map((service: any) => (
              <div class="bg-white p-8 rounded-2xl shadow-sm border border-zinc-100 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
                
                <div class="w-14 h-14 bg-[var(--theme-primary)]/10 rounded-xl flex items-center justify-center mb-6 text-[var(--theme-primary)]">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                
                <h3 class="text-xl font-bold text-zinc-900 mb-3 uppercase tracking-tight">
                  {service.title}
                </h3>
                
                <p class="text-zinc-500 mb-6 leading-relaxed line-clamp-3">
                  {service.description}
                </p>
                
                <a href={`/services/${service.slug.current}`} class="text-[var(--theme-primary)] font-bold text-sm hover:text-zinc-900 transition-colors flex items-center gap-2 w-fit">
                  Read More <span>&rarr;</span>
                </a>
                
              </div>
            ))}

          </div>
        </div>
      </section>
    )}

    <!-- 4. SOCIAL PROOF / TESTIMONIALS -->
    {testimonials.length > 0 && (
      <section class="bg-zinc-900 py-20 md:py-32 px-6">
        <div class="max-w-7xl mx-auto">
          
          <!-- Section Header -->
          <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-black text-white uppercase tracking-tight mb-4">
              Trusted by Locals
            </h2>
            <p class="text-zinc-400 text-lg">
              Don't just take our word for it. See what our customers have to say about our service.
            </p>
          </div>

          <!-- Testimonial Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            
            {testimonials.map((testimonial: any) => (
              <div class="bg-zinc-800 p-8 rounded-2xl border border-zinc-700 relative">
                
                <!-- Quote Icon Accent -->
                <div class="text-[var(--theme-primary)] opacity-50 absolute top-6 right-8">
                  <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z"></path></svg>
                </div>

                <!-- Review Text -->
                <p class="text-zinc-300 italic mb-6 relative z-10 leading-relaxed">
                  "{testimonial.text}"
                </p>
                
                <!-- Author Info -->
                <div>
                  <h4 class="text-white font-bold tracking-tight">{testimonial.authorName}</h4>
                  <p class="text-[var(--theme-primary)] text-sm font-semibold">{testimonial.location}</p>
                </div>

              </div>
            ))}

          </div>
        </div>
      </section>
    )}

    <!-- 5. WHY CHOOSE US -->
    <section class="py-20 md:py-32 px-6 bg-white">
      <div class="max-w-7xl mx-auto">
        
        <!-- Section Header -->
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl md:text-4xl font-black text-zinc-900 uppercase tracking-tight">
            The Industry Standard
          </h2>
          <div class="w-16 h-1 bg-[var(--theme-primary)] mx-auto mt-6"></div>
        </div>

        <!-- 4-Column Feature Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 text-center">
          
          <!-- Feature 1: Licensed -->
          <div>
            <div class="w-16 h-16 bg-zinc-50 border border-zinc-100 rounded-2xl flex items-center justify-center mx-auto mb-6 text-[var(--theme-primary)] shadow-sm">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <h4 class="text-lg font-bold text-zinc-900 mb-2 uppercase tracking-tight">Fully Licensed</h4>
            <p class="text-zinc-500 text-sm leading-relaxed">Certified professionals ensuring every job meets strict safety and compliance standards.</p>
          </div>

          <!-- Feature 2: Fast Response -->
          <div>
            <div class="w-16 h-16 bg-zinc-50 border border-zinc-100 rounded-2xl flex items-center justify-center mx-auto mb-6 text-[var(--theme-primary)] shadow-sm">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h4 class="text-lg font-bold text-zinc-900 mb-2 uppercase tracking-tight">Fast Response</h4>
            <p class="text-zinc-500 text-sm leading-relaxed">Local to the Adelaide Hills, meaning we get to your emergency faster than city-based crews.</p>
          </div>

          <!-- Feature 3: Upfront Pricing -->
          <div>
            <div class="w-16 h-16 bg-zinc-50 border border-zinc-100 rounded-2xl flex items-center justify-center mx-auto mb-6 text-[var(--theme-primary)] shadow-sm">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h4 class="text-lg font-bold text-zinc-900 mb-2 uppercase tracking-tight">Upfront Pricing</h4>
            <p class="text-zinc-500 text-sm leading-relaxed">No hidden fees or surprise hourly rates. We quote the job before we start the work.</p>
          </div>

          <!-- Feature 4: Clean Work -->
          <div>
            <div class="w-16 h-16 bg-zinc-50 border border-zinc-100 rounded-2xl flex items-center justify-center mx-auto mb-6 text-[var(--theme-primary)] shadow-sm">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h4 class="text-lg font-bold text-zinc-900 mb-2 uppercase tracking-tight">Clean & Tidy</h4>
            <p class="text-zinc-500 text-sm leading-relaxed">We treat your property with respect, using drop sheets and leaving the site spotless.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- 6. LEAD CAPTURE FORM -->
    <section id="quote" class="py-20 md:py-32 px-6 bg-zinc-50 border-t border-zinc-200">
      <div class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl overflow-hidden flex flex-col md:flex-row">

        <!-- Left Side: Emergency CTA -->
        <div class="bg-zinc-900 text-white p-12 md:w-5/12 flex flex-col justify-center relative overflow-hidden">
          
          <!-- Abstract Background Shape -->
          <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-white opacity-5 mix-blend-overlay"></div>
          
          <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-4 relative z-10">
            Ready to get started?
          </h2>
          <p class="text-zinc-400 mb-10 leading-relaxed relative z-10">
            Fill out the form and our dispatch team will get back to you within 60 minutes. For immediate emergencies, please call our 24/7 direct line.
          </p>
          
          <div class="mt-auto relative z-10">
            <p class="text-sm text-zinc-400 uppercase tracking-widest font-bold mb-2">
              24/7 Direct Line
            </p>
            <a href="tel:5558675309" class="text-3xl md:text-4xl font-black text-[var(--theme-primary)] hover:text-white transition-colors">
              (555) 867-5309
            </a>
          </div>
        </div>

        <!-- Right Side: The Form -->
        <div class="p-10 md:p-12 md:w-7/12">
          
          <form name="contact" method="POST" data-netlify="true" class="space-y-6">
            
            <!-- Hidden input required by Netlify for spam routing -->
            <input type="hidden" name="form-name" value="contact" />

            <div>
              <label for="name" class="block text-sm font-bold text-zinc-900 uppercase tracking-tight mb-2">Full Name</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-lg focus:outline-none focus:border-[var(--theme-primary)] focus:ring-1 focus:ring-[var(--theme-primary)] transition-colors" placeholder="John Doe">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="phone" class="block text-sm font-bold text-zinc-900 uppercase tracking-tight mb-2">Phone Number</label>
                <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-lg focus:outline-none focus:border-[var(--theme-primary)] focus:ring-1 focus:ring-[var(--theme-primary)] transition-colors" placeholder="(555) 000-0000">
              </div>
              <div>
                <label for="service" class="block text-sm font-bold text-zinc-900 uppercase tracking-tight mb-2">Service Needed</label>
                <select id="service" name="service" class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-lg focus:outline-none focus:border-[var(--theme-primary)] focus:ring-1 focus:ring-[var(--theme-primary)] transition-colors appearance-none cursor-pointer">
                  <option value="emergency">Emergency Repair</option>
                  <option value="installation">New Installation</option>
                  <option value="maintenance">Routine Maintenance</option>
                  <option value="quote">General Quote</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-bold text-zinc-900 uppercase tracking-tight mb-2">How can we help?</label>
              <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-lg focus:outline-none focus:border-[var(--theme-primary)] focus:ring-1 focus:ring-[var(--theme-primary)] transition-colors resize-none" placeholder="Briefly describe your issue..."></textarea>
            </div>

            <button type="submit" class="w-full bg-[var(--theme-primary)] text-white font-bold text-lg uppercase tracking-tight px-8 py-4 rounded-lg hover:opacity-90 transition-colors mt-4 shadow-md">
              Request Free Quote
            </button>
            
          </form>

        </div>
      </div>
    </section>
    

  </body>
</Layout>