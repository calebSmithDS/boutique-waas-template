---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Testimonials from '../components/Testimonials.astro';
import LeadCapture from '../components/LeadCapture.astro';

// 1. Grab the tenant ID intercepted by the middleware
const tenantId = Astro.locals.tenantId;

console.log("MIDDLEWARE PASSED THIS ID:", tenantId);

// 2. Add the $tenantId variable and the 'where' filters to the query
const graphqlQuery = `
  query GetHomeData($tenantId: String!) {
    allSiteSettings(where: { tenantId: { eq: $tenantId } }) {
      heroHeadline
      heroSubheadline
      heroImage {
        asset {
          url
        }
      }
      seoTitle
      seoDescription
    }
    allService(where: { tenantId: { eq: $tenantId } }) {
      title
      description
      slug {
        current
      }
    }
    allTestimonial(where: { tenantId: { eq: $tenantId } }) {
      authorName
      location
      text
    }
  }
`;

const response = await fetch('https://mc1571jp.api.sanity.io/v2025-09-19/graphql/production/default', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ 
    query: graphqlQuery,
    variables: { tenantId } // 3. Pass the variable into the request
  }),
});

const json = await response.json();

const siteData = json?.data?.allSiteSettings?.[0] || {};
const heroImageUrl = siteData?.heroImage?.asset?.url || "https://images.unsplash.com/photo-1621905251189-08b45d6a269e?q=80&w=2069&auto=format&fit=crop";
const services = json?.data?.allService || [];
const testimonials = json?.data?.allTestimonial || [];

console.log("Site Data:", siteData);
console.log("Services:", services);
---

<Layout 
  title={siteData?.seoTitle || "Smith Plumbing | Emergency Plumber Adelaide"} 
  description={siteData?.seoDescription || "Fast, reliable, 24/7 plumbing services in the Adelaide Hills."}
>
  
    <Hero siteData={siteData} />
    {services.length > 0 && (
          <ServicesGrid services={services} />
        )}

    <WhyChooseUs />

    <Testimonials testimonials={testimonials} />

    <LeadCapture phone={siteData?.phone || "0400 000 000"} />

  
</Layout>