---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Snazzi Boutique | Blackwood</title>
    
    <!-- Loading our Premium Fonts: Inter (Sans) and Cormorant Garamond (Serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  </head>
  
  <!-- bg-[#F9F8F6] is our warm off-white boutique background color -->
  <body class="bg-[#F9F8F6] text-stone-900 font-sans antialiased selection:bg-stone-200">
    
    <!-- 1. STICKY HEADER -->
    <header class="fixed w-full top-0 z-50 bg-[#F9F8F6]/80 backdrop-blur-md border-b border-stone-200">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="font-serif text-3xl tracking-wide">Snazzi.</a>
        
        <!-- CTA Button -->
        <a href="#visit" class="text-xs uppercase tracking-widest border border-stone-900 px-6 py-2.5 hover:bg-stone-900 hover:text-white transition-colors duration-300">
          Visit Us
        </a>
      </div>
    </header>

    <!-- 2. HERO SECTION -->
    <section class="relative h-screen flex items-center justify-center overflow-hidden">
      
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <img 
          src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?q=80&w=2560&auto=format&fit=crop" 
          alt="Boutique Interior" 
          class="w-full h-full object-cover"
        />
        <!-- Dark overlay so the white text pops -->
        <div class="absolute inset-0 bg-stone-900/30"></div>
      </div>

      <!-- Hero Text Content -->
      <div class="relative z-10 text-center text-white px-6 mt-16">
        <p class="font-sans text-sm md:text-base uppercase tracking-[0.3em] mb-4">
          Main Road, Blackwood
        </p>
        
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-light mb-8 leading-tight">
          Modern Fashion.<br />Timeless Style.
        </h1>
        
        <a href="#collection" class="inline-block bg-white text-stone-900 text-sm uppercase tracking-widest px-10 py-4 hover:bg-stone-100 transition-colors duration-300">
          Explore Collection
        </a>
      </div>
    </section>

    <!-- We will add the next sections here -->
	<!-- 3. FEATURED COLLECTIONS GRID -->
    <section id="collection" class="py-24 px-6 max-w-7xl mx-auto">
      
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="font-serif text-4xl md:text-5xl mb-4 text-stone-900">Latest Arrivals</h2>
        <p class="text-stone-500 uppercase tracking-widest text-xs md:text-sm">Curated for the season</p>
      </div>

      <!-- The Grid (Mobile: 1 column, Tablet/Desktop: 3 columns) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        
        <!-- Grid Item 1 -->
        <div class="group cursor-pointer">
          <div class="overflow-hidden bg-stone-200 aspect-[3/4] mb-6">
            <img 
              src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1000&auto=format&fit=crop" 
              alt="Model in sweater" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
            />
          </div>
          <h3 class="font-serif text-2xl mb-1 text-stone-900">The Knitwear Edit</h3>
          <p class="text-stone-500 text-sm tracking-wide">Visit Store to Shop</p>
        </div>

        <!-- Grid Item 2 -->
        <div class="group cursor-pointer">
          <div class="overflow-hidden bg-stone-200 aspect-[3/4] mb-6">
            <img 
              src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=1000&auto=format&fit=crop" 
              alt="Accessories" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
            />
          </div>
          <h3 class="font-serif text-2xl mb-1 text-stone-900">Everyday Basics</h3>
          <p class="text-stone-500 text-sm tracking-wide">Visit Store to Shop</p>
        </div>

        <!-- Grid Item 3 -->
        <div class="group cursor-pointer">
          <div class="overflow-hidden bg-stone-200 aspect-[3/4] mb-6">
            <img 
              src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=1000&auto=format&fit=crop" 
              alt="Evening wear" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
            />
          </div>
          <h3 class="font-serif text-2xl mb-1 text-stone-900">Evening Collection</h3>
          <p class="text-stone-500 text-sm tracking-wide">Visit Store to Shop</p>
        </div>

      </div>
      
      <!-- Optional: View All Button -->
      <div class="text-center mt-16">
        <a href="#" class="inline-block border-b border-stone-900 text-stone-900 uppercase tracking-widest text-xs pb-1 hover:text-stone-500 hover:border-stone-500 transition-colors duration-300">
          Explore More On Our Facebook
        </a>
      </div>
      
    </section>

	<!-- 4. ABOUT US / STORY -->
    <section class="py-24 px-6 max-w-7xl mx-auto">
      
      <!-- The Grid (Mobile: 1 column, Tablet/Desktop: 2 columns) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        
        <!-- Column 1: The Image Side -->
        <div class="relative">
          <img 
            src="https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=1000&auto=format&fit=crop" 
            alt="Boutique Interior Details" 
            class="w-full aspect-[4/5] object-cover" 
          />
          <!-- Decorative offset box for a premium editorial feel (Hidden on mobile) -->
          <div class="absolute -bottom-6 -right-6 w-2/3 h-full bg-stone-200 -z-10 hidden md:block"></div>
        </div>

        <!-- Column 2: The Text Side -->
        <div>
          <h2 class="font-serif text-4xl md:text-5xl mb-6 text-stone-900">
            A Blackwood Staple.
          </h2>
          <p class="text-stone-600 mb-6 leading-relaxed">
            Since opening our doors on Main Road, Snazzi Boutique has been the hills' hidden gem for contemporary fashion. We believe in curating high-quality garments that blend everyday comfort with effortless elegance. 
          </p>
          <p class="text-stone-600 mb-10 leading-relaxed">
            Whether you are looking for timeless knitwear or the perfect evening dress, our personalized styling service ensures you leave feeling as beautiful on the outside as you are on the inside.
          </p>
          
          <a href="#" class="border-b border-stone-900 text-stone-900 uppercase tracking-widest text-xs pb-1 hover:text-stone-500 hover:border-stone-500 transition-colors duration-300">
            Learn More About Us
          </a>
        </div>

      </div>
    </section>

	<!-- 5. LOCATION, HOURS & FOOTER -->
    <section id="visit" class="bg-stone-900 text-stone-100 py-24">
      <div class="max-w-7xl mx-auto px-6">
        
        <!-- The Grid (Mobile: 1 col, Tablet/Desktop: 2 col) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
          
          <!-- Column 1: Contact Details & Hours -->
          <div>
            <h2 class="font-serif text-4xl md:text-5xl mb-12 text-white">Visit Us.</h2>
            
            <!-- Address Block -->
            <div class="mb-8">
              <h3 class="uppercase tracking-widest text-xs text-stone-400 mb-3">Location</h3>
              <p class="text-stone-300 leading-relaxed font-light">
                2/239A Main Road<br />
                Blackwood, SA, 5051
              </p>
            </div>
            
            <!-- Contact Block -->
            <div class="mb-8">
              <h3 class="uppercase tracking-widest text-xs text-stone-400 mb-3">Contact</h3>
              <p class="text-stone-300 mb-2 font-light">
                <a href="tel:0882783479" class="hover:text-white transition-colors duration-300">(08) 8278 3479</a>
              </p>
              <p class="text-stone-300 font-light">
                <a href="mailto:snazzisa@bigpond.com" class="hover:text-white transition-colors duration-300">snazzisa@bigpond.com</a>
              </p>
            </div>
            
            <!-- Opening Hours Block -->
            <div class="mb-12">
              <h3 class="uppercase tracking-widest text-xs text-stone-400 mb-3">Opening Hours</h3>
              <table class="w-full text-stone-300 text-sm max-w-xs font-light">
                <tbody>
                  <tr class="border-b border-stone-800"><td class="py-2">Monday - Friday</td><td class="py-2 text-right">9:30 AM - 5:00 PM</td></tr>
                  <tr class="border-b border-stone-800"><td class="py-2">Saturday</td><td class="py-2 text-right">9:30 AM - 4:00 PM</td></tr>
                  <tr><td class="py-2">Sunday</td><td class="py-2 text-right text-stone-500">Closed</td></tr>
                </tbody>
              </table>
            </div>
            
            <!-- Facebook Link -->
            <a href="#" class="inline-block border border-stone-500 text-stone-300 text-xs uppercase tracking-widest px-6 py-2 hover:bg-white hover:text-stone-900 hover:border-white transition-all duration-300">
              Follow on Facebook
            </a>
          </div>

          <!-- Column 2: Google Maps Embed -->
          <div class="w-full h-80 md:h-full min-h-[400px] bg-stone-800 relative overflow-hidden">
            <!-- 
              Map Tricks:
              1. grayscale and opacity-80 makes it fit the premium dark theme.
              2. group-hover/hover effects bring the color back when interacted with.
            -->
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3268.4230230276634!2d138.6146603!3d-35.0185966!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ab12b48742b78f9%3A0x1d58ba2560377c8e!2s2%2F239A%20Main%20Rd%2C%20Blackwood%20SA%205051%2C%20Australia!5e0!3m2!1sen!2sau!4v1715000000000!5m2!1sen!2sau" 
              class="absolute inset-0 w-full h-full border-0 filter grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-700"
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade">
            </iframe>
          </div>

        </div>
        
        <!-- Copyright / Credit -->
        <div class="mt-24 pt-8 border-t border-stone-800 flex flex-col md:flex-row justify-between items-center text-xs text-stone-500 uppercase tracking-widest">
          <p class="mb-4 md:mb-0">&copy; 2026 Snazzi Boutique.</p>
          <p>Designed by You</p>
        </div>
        
      </div>
    </section>
    
  </body>
</html>