---
const { phone = "(555) 867-5309" } = Astro.props;
---

<section id="quote" class="py-20 md:py-32 px-6 bg-zinc-50 border-t border-zinc-200">
  <div class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl overflow-hidden flex flex-col md:flex-row">

    <!-- Left Side: Emergency CTA -->
    <div class="bg-zinc-900 text-white p-12 md:w-5/12 flex flex-col justify-center relative overflow-hidden">
      
      <!-- Abstract Background Shape -->
      <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-white opacity-5 mix-blend-overlay"></div>
      
      <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-4 relative z-10">
        Ready to get started?
      </h2>
      <p class="text-zinc-400 mb-10 leading-relaxed relative z-10">
        Fill out the form and our dispatch team will get back to you within 60 minutes. For immediate emergencies, please call our 24/7 direct line.
      </p>
      
      <div class="mt-auto relative z-10">
        <p class="text-sm text-zinc-400 uppercase tracking-widest font-bold mb-2">
          24/7 Direct Line
        </p>
        <a href={`tel:${phone.replace(/[^0-9]/g, '')}`} class="text-3xl md:text-4xl font-black text-[var(--theme-primary)] hover:text-white transition-colors">
          {phone}
        </a>
      </div>
    </div>

    <!-- Right Side: The Form -->
    <div class="p-10 md:p-12 md:w-7/12">
      
      <form name="contact" method="POST" class="space-y-6">

        <div>
          <label for="name" class="block text-sm font-bold text-zinc-900 uppercase tracking-tight mb-2">Full Name</label>
          <input type="text" id="name" name="name" required class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-lg focus:outline-none focus:border-[var(--theme-primary)] focus:ring-1 focus:ring-[var(--theme-primary)] transition-colors" placeholder="John Doe">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="phone-input" class="block text-sm font-bold text-zinc-900 uppercase tracking-tight mb-2">Phone Number</label>
            <input type="tel" id="phone-input" name="phone" required class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-lg focus:outline-none focus:border-[var(--theme-primary)] focus:ring-1 focus:ring-[var(--theme-primary)] transition-colors" placeholder="(555) 000-0000">
          </div>
          <div>
            <label for="service" class="block text-sm font-bold text-zinc-900 uppercase tracking-tight mb-2">Service Needed</label>
            <select id="service" name="service" class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-lg focus:outline-none focus:border-[var(--theme-primary)] focus:ring-1 focus:ring-[var(--theme-primary)] transition-colors appearance-none cursor-pointer">
              <option value="emergency">Emergency Repair</option>
              <option value="installation">New Installation</option>
              <option value="maintenance">Routine Maintenance</option>
              <option value="quote">General Quote</option>
            </select>
          </div>
        </div>

        <div>
          <label for="message" class="block text-sm font-bold text-zinc-900 uppercase tracking-tight mb-2">How can we help?</label>
          <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 bg-zinc-50 border border-zinc-200 rounded-lg focus:outline-none focus:border-[var(--theme-primary)] focus:ring-1 focus:ring-[var(--theme-primary)] transition-colors resize-none" placeholder="Briefly describe your issue..."></textarea>
        </div>

        <button type="submit" class="w-full bg-[var(--theme-primary)] text-white font-bold text-lg uppercase tracking-tight px-8 py-4 rounded-lg hover:opacity-90 transition-colors mt-4 shadow-md">
          Request Free Quote
        </button>
        
      </form>

    </div>
  </div>
</section>

<script>
  const form = document.querySelector('form[name="contact"]') as HTMLFormElement;
  
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault(); 
      
      // 1. Scoop up the form data
      const formData = new FormData(form);
      
      // 2. Convert it into a clean JSON dictionary
      const data = Object.fromEntries(formData.entries());
      
      // 3. Shoot it directly to your Pipedream URL
      fetch('https://eot7rvp721r6dvj.m.pipedream.net', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      .then(() => {
        console.log("Boom. Sent straight to Pipedream.");
        form.reset(); 
      })
      .catch((error) => console.error('Form submission error:', error));
    });
  }
</script>