---
const { phone = "(555) 867-5309" } = Astro.props;
---

<section id="quote" class="py-20 md:py-32 px-6 bg-zinc-50 border-t border-zinc-200">
  <div class="max-w-5xl mx-auto bg-white rounded-3xl shadow-xl overflow-hidden flex flex-col md:flex-row">

    <!-- Left Side: Emergency CTA -->
    <div class="bg-zinc-900 text-white p-12 md:w-5/12 flex flex-col justify-center relative overflow-hidden">
      
      <!-- Abstract Background Shape -->
      <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-white opacity-5 mix-blend-overlay"></div>
      
      <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-4 relative z-10">
        Ready to get started?
      </h2>
      <p class="text-zinc-400 mb-10 leading-relaxed relative z-10">
        Fill out the form and our dispatch team will get back to you within 60 minutes. For immediate emergencies, please call our 24/7 direct line.
      </p>
      
      <div class="mt-auto relative z-10">
        <p class="text-sm text-zinc-400 uppercase tracking-widest font-bold mb-2">
          24/7 Direct Line
        </p>
        <a href={`tel:${phone.replace(/[^0-9]/g, '')}`} class="text-3xl md:text-4xl font-black text-[var(--theme-primary)] hover:text-white transition-colors">
          {phone}
        </a>
      </div>
    </div>

    <!-- Right Side: The Form -->
    <div class="p-10 md:p-12 md:w-7/12">
      
      <form id="lead-form" class="space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium text-zinc-700 mb-1">Your Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            placeholder="John Doe"
            class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:ring-2 focus:ring-[var(--theme-primary)] focus:outline-none"
          />
        </div>

        <div>
          <label for="phone" class="block text-sm font-medium text-zinc-700 mb-1">Phone Number</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            required 
            placeholder="0400 000 000"
            class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:ring-2 focus:ring-[var(--theme-primary)] focus:outline-none"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-zinc-700 mb-1">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="john@example.com"
            class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:ring-2 focus:ring-[var(--theme-primary)] focus:outline-none"
          />
        </div>

        <div>
          <label for="service" class="block text-sm font-medium text-zinc-700 mb-1">Service Needed</label>
          <select 
            id="service" 
            name="service"
            class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:ring-2 focus:ring-[var(--theme-primary)] focus:outline-none"
          >
            <option value="General Inquiry">General Inquiry</option>
            <option value="Emergency Repair">Emergency Repair</option>
            <option value="Installation">Installation</option>
          </select>
        </div>

        <div>
          <label for="details" class="block text-sm font-medium text-zinc-700 mb-1">Details</label>
          <textarea 
            id="details" 
            name="details" 
            rows="4"
            required 
            placeholder="Please describe what you need help with..."
            class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:ring-2 focus:ring-[var(--theme-primary)] focus:outline-none resize-y"
          ></textarea>
        </div>
        <!-- Status / Error message container -->
        <div id="form-feedback" class="hidden text-sm font-medium p-3 rounded-lg"></div>

        <!-- Submit button -->
        <button 
          type="submit" 
          id="submit-btn" 
          class="w-full py-3 px-6 rounded-lg font-bold text-white bg-[var(--theme-primary)] hover:opacity-90 transition-opacity flex justify-center items-center gap-2"
        >
          <span id="btn-text">Get a Free Quote</span>
          <span id="btn-spinner" class="hidden animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></span>
        </button>
      </form>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const feedback = document.getElementById('form-feedback');

  if (form && submitBtn && btnText && btnSpinner && feedback) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Set loading state
      submitBtn.disabled = true;
      btnText.textContent = 'Sending...';
      btnSpinner.classList.remove('hidden');
      feedback.classList.add('hidden');

      const formData = new FormData(form);

      try {
        const response = await fetch('/api/submit-lead', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        if (response.ok && data.success) {
          // Success UI
          feedback.textContent = 'Thank you! We will be in touch shortly.';
          feedback.className = 'text-sm font-medium p-3 rounded-lg bg-green-50 text-green-800 border border-green-200 block';
          form.reset();
        } else {
          // Validation / server handled error
          throw new Error(data.error || 'Failed to submit the form.');
        }
      } catch (err: any) {
        // Failure UI
        feedback.textContent = err.message || 'Something went wrong. Please try calling directly.';
        feedback.className = 'text-sm font-medium p-3 rounded-lg bg-red-50 text-red-800 border border-red-200 block';
      } finally {
        // Reset button state
        submitBtn.disabled = false;
        btnText.textContent = 'Get a Free Quote';
        btnSpinner.classList.add('hidden');
      }
    });
  }
</script>