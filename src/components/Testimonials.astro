---
interface Review {
  authorName: string;
  rating: number;
  text: string;
  source?: string;
}

interface Props {
  reviews: Review[];
}

// 1. Accept the new 'reviews' array passed from index.astro
const { reviews = [] } = Astro.props;

// 2. Fallback data mapped to the new Sanity schema
const displayReviews = reviews.length > 0 ? reviews : [
  {
    text: "They arrived within 30 minutes of my emergency call and fixed the leak perfectly. Highly recommend their prompt service.",
    authorName: "Sarah Jenkins",
    rating: 5,
    source: "manual"
  },
  {
    text: "Very professional, transparent pricing, and left the worksite cleaner than they found it. Will definitely use them again.",
    authorName: "Mark Davis",
    rating: 5,
    source: "google"
  }
];
---

<section id="reviews" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-black text-zinc-900 uppercase tracking-tight mb-4">What Our Clients Say</h2>
      <div class="w-24 h-1 bg-[var(--theme-primary)] mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {displayReviews.map((review) => (
        <div class="bg-zinc-50 p-8 rounded-2xl border border-zinc-100 relative flex flex-col h-full">
          
          <!-- Decorative Quote SVG -->
          <svg class="absolute top-6 left-6 w-8 h-8 text-zinc-200" fill="currentColor" viewBox="0 0 32 32">
            <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
          </svg>

          <div class="relative z-10 pl-8 flex flex-col flex-grow">
            
            <!-- Dynamic Star Rating -->
            <div class="flex gap-1 text-yellow-400 mb-4">
              {Array.from({ length: review.rating || 5 }).map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Review Text -->
            <p class="text-zinc-600 text-lg italic mb-6 flex-grow">"{review.text}"</p>
            
            <!-- Author & Source Badge -->
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-zinc-200">
              <p class="font-bold text-zinc-900">{review.authorName}</p>
              
              {review.source === 'google' && (
                <span class="flex items-center gap-1 text-xs font-bold text-zinc-500 uppercase tracking-wider">
                  <svg class="w-4 h-4 text-blue-500" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                  </svg>
                  Google
                </span>
              )}
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>