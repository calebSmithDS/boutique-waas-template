---
const { testimonials = [] } = Astro.props;

// Fallback data if no testimonials are passed from Sanity yet
const displayTestimonials = testimonials.length > 0 ? testimonials : [
  {
    quote: "They arrived within 30 minutes of my emergency call and fixed the leak perfectly. Highly recommend their prompt service.",
    author: "Sarah Jenkins",
    role: "Homeowner"
  },
  {
    quote: "Very professional, transparent pricing, and left the worksite cleaner than they found it. Will definitely use them again.",
    author: "Mark Davis",
    role: "Local Business Owner"
  }
];
---

<section id="testimonials" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-black text-zinc-900 uppercase tracking-tight mb-4">What Our Clients Say</h2>
      <div class="w-24 h-1 bg-[var(--theme-primary)] mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {displayTestimonials.map((testimonial) => (
        <div class="bg-zinc-50 p-8 rounded-2xl border border-zinc-100 relative">
          <svg class="absolute top-6 left-6 w-8 h-8 text-zinc-200" fill="currentColor" viewBox="0 0 32 32">
            <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
          </svg>
          <div class="relative z-10 pl-8">
            <p class="text-zinc-600 text-lg italic mb-6">"{testimonial.quote}"</p>
            <div>
              <p class="font-bold text-zinc-900">{testimonial.author}</p>
              {testimonial.role && <p class="text-sm text-zinc-500">{testimonial.role}</p>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>