---
const { features = [] } = Astro.props;

// Fallback data if Sanity doesn't provide specific features
const displayFeatures = features.length > 0 ? features : [
  {
    title: "Licensed & Insured",
    description: "Fully certified professionals. Your property is completely protected while we work.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`
  },
  {
    title: "Upfront Pricing",
    description: "No hidden fees or surprise hourly charges. You approve the exact price before we start.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
  },
  {
    title: "24/7 Emergency",
    description: "Plumbing emergencies don't wait for business hours. We are on call day and night.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
  }
];
---

<section class="py-20 bg-zinc-900 text-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-black uppercase tracking-tight mb-4">Why Choose Us</h2>
      <div class="w-24 h-1 bg-[var(--theme-primary)] mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {displayFeatures.map((feature) => (
        <div class="text-center group">
          <div class="w-16 h-16 mx-auto bg-zinc-800 rounded-full flex items-center justify-center text-[var(--theme-primary)] mb-6 group-hover:scale-110 transition-transform duration-300" set:html={feature.icon}>
          </div>
          <h3 class="text-xl font-bold mb-3">{feature.title}</h3>
          <p class="text-zinc-400 leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>