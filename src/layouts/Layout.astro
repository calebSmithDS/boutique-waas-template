---
import '../styles/global.css';

// 1. Accept the unified data passed from index.astro
const { tenant = {} } = Astro.props;

// 2. Set up your clean variables using the single tenant object
const businessName = tenant.businessName || "Local Trade Professionals";
const brandColor = tenant.primaryColor?.hex || '#c2561a';
const fontName = 'Inter';
const fontUrl = `https://fonts.googleapis.com/css2?family=${fontName}:wght@400;500;700;900&display=swap`;
const buttonShape = 'rounded-md';
const logoUrl = tenant.logo?.asset?.url;
const phone = tenant.publicPhone || "(555) 867-5309";
const email = tenant.contactEmail || "contact@youragency.com";

// SEO Fallbacks
const title = `${businessName} | Professional Services`;
const description = `Fast, reliable, and professional trade services by ${businessName}.`;

// 3. Construct the Schema object
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": businessName,
  "image": logoUrl,
  "telephone": phone,
  "url": `https://${Astro.request.headers.get('host')}`
};

// 4. Turn the object into a string to inject into HTML
const schemaString = JSON.stringify(localBusinessSchema);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph tags for when they share their site on Facebook/iMessage -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Dynamically load the chosen font -->
    <link href={fontUrl} rel="stylesheet">

    <!-- Inject the Schema as pure text into the head -->
    <script type="application/ld+json" set:html={schemaString} />
  </head>
  
  <body class="text-zinc-900 antialiased selection:bg-zinc-200" style={`font-family: '${fontName}', sans-serif;`}>

  <!-- Astro's superpower: Injecting JS variables directly into CSS -->
    <style define:vars={{ brandColor }}>
      :root {
        --theme-primary: var(--brandColor);
      }
    </style>
    
   <!-- GLOBAL STICKY HEADER -->
    <header class="w-full bg-white border-b border-zinc-100 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
        
        <!-- Logo Area -->
        <a href="/" class="flex items-center shrink-0 z-50">
          {logoUrl ? (
            <img src={logoUrl} alt="Company Logo" class="h-10 w-auto object-contain" />
          ) : (
            <span class="font-black text-xl tracking-tight text-zinc-900 uppercase">
              {businessName}
            </span>
          )}
        </a>
        
        <!-- Desktop Navigation (Hidden on Mobile) -->
        <nav class="hidden lg:flex items-center gap-8 text-sm font-medium text-zinc-500">
          <a href="/" class="bg-zinc-100 text-zinc-900 px-4 py-2 rounded-md">Home</a>
          <a href="/#services" class="hover:text-zinc-900 transition-colors">Services</a>
          <a href="/#reviews" class="hover:text-zinc-900 transition-colors">Reviews</a>
          <a href="/#quote" class="hover:text-zinc-900 transition-colors">Contact</a>
        </nav>

        <!-- Desktop Contact & CTA (Hidden on Mobile) -->
        <div class="hidden md:flex items-center gap-5">
          <a href={`tel:${phone.replace(/[^0-9]/g, '')}`} class="font-bold text-zinc-900 hover:text-[var(--theme-primary)] transition-colors">
            {phone}
          </a>
          <a href="/#quote" class={`bg-[var(--theme-primary)] text-white text-sm font-bold px-6 py-3 hover:opacity-90 transition-colors ${buttonShape}`}>
            Free Quote
          </a>
        </div>

        <!-- Mobile Hamburger Button (Hidden on Desktop) -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-zinc-600 hover:text-zinc-900 focus:outline-none z-50" aria-label="Toggle menu">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden absolute top-24 left-0 w-full bg-white border-b border-zinc-100 shadow-xl lg:hidden flex-col items-center py-6 gap-6 text-lg font-bold text-zinc-800">
        <a href="/" class="mobile-link hover:text-[var(--theme-primary)] transition-colors">Home</a>
        <a href="/#services" class="mobile-link hover:text-[var(--theme-primary)] transition-colors">Services</a>
        <a href="/#reviews" class="mobile-link hover:text-[var(--theme-primary)] transition-colors">Reviews</a>
        <a href="/#quote" class="mobile-link hover:text-[var(--theme-primary)] transition-colors">Contact</a>
      </div>
    </header>

    <!-- PAGE SPECIFIC CONTENT INJECTED HERE -->
    <slot />

    <!-- MOBILE FLOATING QUOTE BUTTON -->
    <div id="mobile-sticky-bar" class="md:hidden fixed bottom-6 right-6 z-50 transition-transform duration-300 translate-y-[200%]">
      <a href="/#quote" class="flex items-center gap-2 bg-[var(--theme-primary)] text-white font-bold text-sm uppercase tracking-wide px-6 py-4 rounded-full shadow-2xl hover:scale-105 transition-transform border border-white/20">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        Get Quote
      </a>
    </div>

    <!-- HAMBURGER SCRIPT -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const links = document.querySelectorAll('.mobile-link');

      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
          menu.classList.toggle('flex');
        });

        links.forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.add('hidden');
            menu.classList.remove('flex');
          });
        });
      }

      // Floating Button Scroll Logic
      const stickyBar = document.getElementById('mobile-sticky-bar');
      const mainQuoteBtn = document.getElementById('main-quote-btn');

      if (stickyBar && mainQuoteBtn) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              stickyBar.classList.add('translate-y-[200%]');
              stickyBar.classList.remove('translate-y-0');
            } else {
              stickyBar.classList.remove('translate-y-[200%]');
              stickyBar.classList.add('translate-y-0');
            }
          });
        }, { threshold: 0 }); 

        observer.observe(mainQuoteBtn);
      }
    </script>

    <!-- GLOBAL FOOTER -->
    <footer class="pb-24 md:pb-0 bg-zinc-900 text-zinc-300 py-12 px-6 mt-auto">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
        <div>
          <a href="/" class="mb-4 inline-block">
            {logoUrl ? (
              <img src={logoUrl} alt="Company Logo" class="h-10 w-auto object-contain grayscale opacity-75 hover:grayscale-0 hover:opacity-100 transition-all" />
            ) : (
              <span class="font-black text-2xl tracking-tighter text-white uppercase">
                {businessName}
              </span>
            )}
          </a>
          <p class="text-sm leading-relaxed text-zinc-400 max-w-xs mt-2">
            Professional, licensed, and reliable trade services. We deliver upfront pricing and fast response times.
          </p>
        </div>
        <div>
          <h4 class="text-white font-bold uppercase tracking-tight mb-4">Quick Links</h4>
          <ul class="space-y-3 text-sm font-medium">
            <li><a href="/#services" class="hover:text-[var(--theme-primary)] transition-colors">Our Services</a></li>
            <li><a href="/#quote" class="hover:text-[var(--theme-primary)] transition-colors">Request a Quote</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-bold uppercase tracking-tight mb-4">Contact</h4>
          <ul class="space-y-3 text-sm font-medium">
            <li><a href={`tel:${phone.replace(/[^0-9]/g, '')}`} class="hover:text-[var(--theme-primary)] transition-colors">{phone}</a></li>
            <li><a href={`mailto:${email}`} class="hover:text-[var(--theme-primary)] transition-colors">{email}</a></li>
          </ul>
        </div>
      </div>
      <div class="max-w-7xl mx-auto pt-8 border-t border-zinc-800 text-xs md:text-sm flex flex-col md:flex-row justify-between items-center gap-4 text-zinc-500">
        <p>&copy; {new Date().getFullYear()} {businessName}. All rights reserved.</p>
        <p>Website by <a href="#" class="text-white font-bold hover:text-[var(--theme-primary)] transition-colors">Your WaaS Agency</a></p>
      </div>
    </footer>
    
  </body>
</html>